// Draft v2.0.0 — hasil diskusi desain skema (lihat diskusi_cms_corporate.txt +
// CHANGELOG.txt v1.5.4). BELUM final: menunggu review & penyesuaian user.
// Keputusan yang sudah dikonfirmasi:
//   1. Rich content (Service.detailContent, BlogPost.detailContent) -> Json?, bukan tabel relasional
//   2. Soft delete (deletedAt) hanya di tabel konten utama, bukan tabel lookup
//   3. TeamMember & Testimonial masing-masing 1 tabel gabungan (source of truth
//      dipilih saat migrasi data mock, bukan digabung dari semua versi yang ada)

generator client {
  provider = "prisma-client-js"
}

//datasource db {
//  provider = "mysql"
//  url      = "mysql://u858331583_izinpro:Sandibaru%4023@localhost:3306/u858331583_izinpro"
//}

datasource db {
  provider = "mysql" // MariaDB (Rumahweb), compatible dgn protocol mysql
  url      = env("DATABASE_URL")
}

// ====================================================
// Domain 1 — Auth & User (Better Auth)
// ====================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  role          Role      @default(EDITOR)
  isActive      Boolean   @default(true)
  deletedAt     DateTime? // soft delete — akun gak dihapus permanen, cuma disembunyikan
  createdById   String?
  createdBy     User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedById   String?
  updatedBy     User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedById   String?
  deletedBy     User?     @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdUsers    User[]     @relation("UserCreatedBy")
  updatedUsers    User[]     @relation("UserUpdatedBy")
  deletedUsers    User[]     @relation("UserDeletedBy")
  sessions        Session[]
  accounts        Account[]
  blogPosts       BlogPost[] @relation("BlogPostAuthor")
  uploadedMedia   Media[]    @relation("MediaUploader")
  assignedInquiry Inquiry[]  @relation("InquiryAssignee")
  auditLogs       AuditLog[]

  // Jejak "dibuat oleh" / "diubah oleh" — satu pasang relasi per tabel konten
  // (nama relasi eksplisit krn 2 relasi berbeda ke User yg sama per tabel)
  createdCategories            Category[]             @relation("CategoryCreatedBy")
  updatedCategories            Category[]             @relation("CategoryUpdatedBy")
  updatedBlogPosts             BlogPost[]             @relation("BlogPostUpdatedBy")
  deletedBlogPosts             BlogPost[]             @relation("BlogPostDeletedBy")
  createdPages                 Page[]                 @relation("PageCreatedBy")
  updatedPages                 Page[]                 @relation("PageUpdatedBy")
  createdTeamMembers           TeamMember[]           @relation("TeamMemberCreatedBy")
  updatedTeamMembers           TeamMember[]           @relation("TeamMemberUpdatedBy")
  createdServiceCategories     ServiceCategory[]      @relation("ServiceCategoryCreatedBy")
  updatedServiceCategories     ServiceCategory[]      @relation("ServiceCategoryUpdatedBy")
  createdServices              Service[]              @relation("ServiceCreatedBy")
  updatedServices              Service[]              @relation("ServiceUpdatedBy")
  deletedServices              Service[]              @relation("ServiceDeletedBy")
  createdServicePackages       ServicePackage[]       @relation("ServicePackageCreatedBy")
  updatedServicePackages       ServicePackage[]       @relation("ServicePackageUpdatedBy")
  createdTestimonials          Testimonial[]          @relation("TestimonialCreatedBy")
  updatedTestimonials          Testimonial[]          @relation("TestimonialUpdatedBy")
  deletedTestimonials          Testimonial[]          @relation("TestimonialDeletedBy")
  createdPartners              Partner[]              @relation("PartnerCreatedBy")
  updatedPartners              Partner[]              @relation("PartnerUpdatedBy")
  deletedPartners              Partner[]              @relation("PartnerDeletedBy")
  createdFaqs                  Faq[]                  @relation("FaqCreatedBy")
  updatedFaqs                  Faq[]                  @relation("FaqUpdatedBy")
  createdPromoBanners          PromoBanner[]          @relation("PromoBannerCreatedBy")
  updatedPromoBanners          PromoBanner[]          @relation("PromoBannerUpdatedBy")
  createdPromoPackages         PromoPackage[]         @relation("PromoPackageCreatedBy")
  updatedPromoPackages         PromoPackage[]         @relation("PromoPackageUpdatedBy")
  createdCtas                  Cta[]                  @relation("CtaCreatedBy")
  updatedCtas                  Cta[]                  @relation("CtaUpdatedBy")
  updatedInquiries             Inquiry[]              @relation("InquiryUpdatedBy")
  createdMenus                 Menu[]                 @relation("MenuCreatedBy")
  updatedMenus                 Menu[]                 @relation("MenuUpdatedBy")
  deletedMenus                 Menu[]                 @relation("MenuDeletedBy")
  createdMenuItems             MenuItem[]             @relation("MenuItemCreatedBy")
  updatedMenuItems             MenuItem[]             @relation("MenuItemUpdatedBy")
  deletedMenuItems             MenuItem[]             @relation("MenuItemDeletedBy")
  updatedSettings              Settings[]             @relation("SettingsUpdatedBy")
  updatedHeroContents          HeroContent[]          @relation("HeroContentUpdatedBy")
  updatedAboutHomeContents     AboutHomeContent[]     @relation("AboutHomeContentUpdatedBy")
  updatedAboutPageContents     AboutPageContent[]     @relation("AboutPageContentUpdatedBy")
  updatedTestimoniPageContents TestimoniPageContent[] @relation("TestimoniPageContentUpdatedBy")
  updatedPromoPageContents     PromoPageContent[]     @relation("PromoPageContentUpdatedBy")
  updatedKontakPageContents    KontakPageContent[]    @relation("KontakPageContentUpdatedBy")
  updatedBlogPageContents      BlogPageContent[]      @relation("BlogPageContentUpdatedBy")

  // Modul Transaksi (Service Transaction Management) — sama pola jejak
  // dibuat/diubah/dihapus dgn model lain di atas.
  createdWorkflowTemplates WorkflowTemplate[]        @relation("WorkflowTemplateCreatedBy")
  updatedWorkflowTemplates WorkflowTemplate[]        @relation("WorkflowTemplateUpdatedBy")
  deletedWorkflowTemplates WorkflowTemplate[]        @relation("WorkflowTemplateDeletedBy")
  createdTransactions      ServiceTransaction[]      @relation("ServiceTransactionCreatedBy")
  updatedTransactions      ServiceTransaction[]      @relation("ServiceTransactionUpdatedBy")
  deletedTransactions      ServiceTransaction[]      @relation("ServiceTransactionDeletedBy")
  assignedTransactions     ServiceTransaction[]      @relation("ServiceTransactionAssignedStaff")
  updatedWorkflowSteps     TransactionWorkflowStep[] @relation("TransactionWorkflowStepUpdatedBy")
  recordedPayments         Payment[]                 @relation("PaymentRecordedBy")
  uploadedTransactionFiles TransactionAttachment[]   @relation("TransactionAttachmentUploadedBy")
  transactionActivityLogs  TransactionActivityLog[]  @relation("TransactionActivityLogUser")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ====================================================
// Domain 2 — Konten
// ====================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
}

/**
 * Status khusus BlogPost — beda enum dari ContentStatus (Page pakai
 * ContentStatus) karena cuma Blog yang butuh SCHEDULED. Di MySQL, enum
 * Prisma cuma nentuin ENUM(...) per kolom, jadi ini gak nyentuh kolom
 * status di tabel `pages`.
 */
enum BlogPostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  createdById String?
  createdBy   User?      @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?      @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]

  @@map("categories")
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  excerpt         String
  content         String         @db.Text
  detailContent   Json?
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  authorId        String
  author          User           @relation("BlogPostAuthor", fields: [authorId], references: [id])
  featuredMediaId String?
  featuredMedia   Media?         @relation("BlogPostFeaturedMedia", fields: [featuredMediaId], references: [id])
  views           Int            @default(0) // mock nyimpen string ringkas ("1.2K") sbg tampilan, DB simpan angka mentah spy bisa di-increment & sort (pola sama dgn Media.sizeBytes)
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime? // cuma keisi kalau status SCHEDULED — target waktu auto-publish (lihat api/cron/publish-scheduled-posts)
  metaTitle       String?
  metaDescription String?
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?          @relation("BlogPostDeletedBy", fields: [deletedById], references: [id])
  // authorId di atas sudah berfungsi sbg "dibuat oleh" — cuma perlu updatedBy
  updatedById     String?
  updatedBy       User?          @relation("BlogPostUpdatedBy", fields: [updatedById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tags            PostTag[]
  comments        Comment[]
  viewLogs        ArticleView[]

  @@map("blog_posts")
}

model Tag {
  id    String    @id @default(cuid())
  name  String
  slug  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Page {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  heroTitle    String
  heroSubtitle String
  status       ContentStatus @default(DRAFT)
  isCore       Boolean       @default(false) // halaman inti (Beranda, Layanan, dll) tidak bisa dihapus, sesuai tombol Hapus yg disembunyikan di admin/pages
  deletedAt    DateTime?
  createdById  String?
  createdBy    User?         @relation("PageCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?         @relation("PageUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("pages")
}

// ====================================================
// Domain 3 — Media & Tim
// ====================================================

model Media {
  id           String   @id @default(cuid())
  fileName     String
  url          String   @unique // ukuran large/original
  thumbnailUrl String? // 150px, auto-generate via Sharp.js
  mediumUrl    String? // 600px, auto-generate via Sharp.js
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  title        String // wajib diisi — dasar search di Media Library, auto-diisi dari nama file saat upload/sinkron
  altText      String? // opsional, dipakai sbg atribut alt <img> kalau diisi
  uploadedById String? // null = file statis hasil sinkron dari folder public/ (bukan upload lewat CMS), lihat syncStaticMediaFiles()
  uploadedBy   User?    @relation("MediaUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  blogPostsFeatured BlogPost[]    @relation("BlogPostFeaturedMedia")
  teamMembers       TeamMember[]  @relation("TeamMemberPhoto")
  services          Service[]     @relation("ServiceFeaturedMedia")
  servicesAbout     Service[]     @relation("ServiceAboutMedia")
  testimonials      Testimonial[] @relation("TestimonialPhoto")
  partners          Partner[]     @relation("PartnerLogo")
  promoBanners      PromoBanner[] @relation("PromoBannerImage")

  @@map("media")
}

model TeamMember {
  id           String    @id @default(cuid())
  name         String
  role         String
  // *En/*Zh kosong = fallback ke `role` di publik (lihat TentangKamiPage).
  roleEn       String?
  roleZh       String?
  department   String?
  email        String?
  phone        String?
  location     String?
  linkedinUrl  String?
  photoMediaId String?
  photoMedia   Media?    @relation("TeamMemberPhoto", fields: [photoMediaId], references: [id])
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  deletedAt    DateTime?
  createdById  String?
  createdBy    User?     @relation("TeamMemberCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?     @relation("TeamMemberUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("team_members")
}

// ====================================================
// Domain 4 — Bisnis Inti
// ====================================================

// GLOBAL dipakai di FAQ Beranda & fallback Detail Layanan; KONTAK di halaman
// Kontak; SERVICE di Detail Layanan tertentu (lihat serviceId).
enum FaqScope {
  GLOBAL
  KONTAK
  SERVICE
}

enum CtaLocation {
  BERANDA
  LAYANAN
  DETAIL_LAYANAN
  BLOG
  DETAIL_BLOG
  PROMO
  TENTANG_KAMI
  TESTIMONI
  KONTAK
  TRACKING
}

model ServiceCategory {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameEn        String? // kosong = fallback ke `name` di publik
  nameZh        String?
  icon          String?
  description   String?  @db.Text
  descriptionEn String?  @db.Text
  descriptionZh String?  @db.Text
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdById   String?
  createdBy     User?    @relation("ServiceCategoryCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?    @relation("ServiceCategoryUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services     Service[]
  testimonials Testimonial[]

  @@map("service_categories")
}

model Service {
  id                     String          @id @default(cuid())
  slug                   String          @unique
  title                  String
  titleEn                String? // kosong = fallback ke `title` di publik
  titleZh                String?
  description            String          @db.Text
  descriptionEn          String?         @db.Text
  descriptionZh          String?         @db.Text
  icon                   String?
  color                  String?
  bgColor                String?
  categoryId             String
  category               ServiceCategory @relation(fields: [categoryId], references: [id])
  featuredMediaId        String?
  featuredMedia          Media?          @relation("ServiceFeaturedMedia", fields: [featuredMediaId], references: [id])
  aboutMediaId           String? // gambar khusus section "Tentang" di /layanan/[slug] — opsional, fallback ke featuredMedia (gambar Hero) kalau kosong
  aboutMedia             Media?          @relation("ServiceAboutMedia", fields: [aboutMediaId], references: [id])
  features               Json
  featuresEn             Json? // string[] — cuma kepake di fallbackContent() about.checklist, lihat hydrate-layanan-detail.ts
  featuresZh             Json?
  detailContent          Json? // ServiceDetailContent (lihat src/lib/types/service-detail-content.ts) — highlights, stats, about, benefits, jenis izin, proses, dokumen, durasi, dll utk /layanan/[slug]
  detailContentEn        Json? // ServiceDetailContentLang (deep-partial ServiceDetailContent) — fallback per-field ke `detailContent`, lihat pickServiceDetailContent()
  detailContentZh        Json?
  estimatedDurationLabel String? // mis. "7-14 hari kerja" — dipakai modul Transaksi (WorkflowTemplate/ServiceTransaction)
  basePrice              Decimal?        @db.Decimal(12, 2) // harga dasar dipakai modul Transaksi, beda dari harga per-paket (ServicePackage.price)
  requiredDocuments      Json? // string[] dokumen yg wajib disiapkan customer, dipakai modul Transaksi
  gallery                Json? // { url: string; alt: string }[] — galeri foto layanan, dipakai modul Transaksi
  metaTitle              String?
  metaTitleEn            String?
  metaTitleZh            String?
  metaDescription        String?
  metaDescriptionEn      String?
  metaDescriptionZh      String?
  status                 ContentStatus   @default(PUBLISHED)
  isActive               Boolean         @default(true)
  sortOrder              Int             @default(0)
  deletedAt              DateTime?
  deletedById            String?
  deletedBy              User?           @relation("ServiceDeletedBy", fields: [deletedById], references: [id])
  createdById            String?
  createdBy              User?           @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?           @relation("ServiceUpdatedBy", fields: [updatedById], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  packages          ServicePackage[]
  faqs              Faq[]
  promoPackages     PromoPackage[]
  inquiries         Inquiry[]
  workflowTemplates WorkflowTemplate[]
  transactions      ServiceTransaction[]

  @@map("services")
}

model ServicePackage {
  id                     String   @id @default(cuid())
  serviceId              String
  service                Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name                   String
  nameEn                 String? // kosong = fallback ke `name` di publik
  nameZh                 String?
  price                  Decimal  @db.Decimal(12, 2)
  originalPrice          Decimal? @db.Decimal(12, 2)
  features               Json
  featuresEn             Json?
  featuresZh             Json?
  isPopular              Boolean  @default(false)
  estimatedDurationLabel String? // mis. "5-7 hari kerja" — dipakai modul Transaksi
  isActive               Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdById            String?
  createdBy              User?    @relation("ServicePackageCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?    @relation("ServicePackageUpdatedBy", fields: [updatedById], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  transactions ServiceTransaction[]

  @@map("service_packages")
}

model Testimonial {
  id           String           @id @default(cuid())
  name         String
  role         String?
  company      String?
  content      String?          @db.Text
  rating       Int?
  categoryId   String?
  category     ServiceCategory? @relation(fields: [categoryId], references: [id])
  photoMediaId String?
  photoMedia   Media?           @relation("TestimonialPhoto", fields: [photoMediaId], references: [id])
  isVideo      Boolean          @default(false)
  videoUrl     String?
  thumbnailUrl String?
  duration     String?
  isActive     Boolean          @default(true)
  sortOrder    Int              @default(0)
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?            @relation("TestimonialDeletedBy", fields: [deletedById], references: [id])
  createdById  String?
  createdBy    User?            @relation("TestimonialCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?            @relation("TestimonialUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("testimonials")
}

model Partner {
  id          String    @id @default(cuid())
  name        String
  logoMediaId String
  logoMedia   Media     @relation("PartnerLogo", fields: [logoMediaId], references: [id])
  isActive    Boolean   @default(true)
  deletedAt   DateTime? // soft delete
  deletedById String?
  deletedBy   User?     @relation("PartnerDeletedBy", fields: [deletedById], references: [id])
  sortOrder   Int       @default(0)
  createdById String?
  createdBy   User?     @relation("PartnerCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("PartnerUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("partners")
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  scope       FaqScope @default(GLOBAL)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdBy   User?    @relation("FaqCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("FaqUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

enum PromoBannerVariant {
  DISCOUNT
  FREE
  PACKAGE
}

model PromoBanner {
  id             String             @id @default(cuid())
  tag            String?
  eyebrow        String
  eyebrowEn      String?
  eyebrowZh      String?
  title          String
  titleEn        String?
  titleZh        String?
  description    String?            @db.Text
  descriptionEn  String?            @db.Text
  descriptionZh  String?            @db.Text
  ctaLabel       String?
  ctaLabelEn     String?
  ctaLabelZh     String?
  ctaHref        String?
  imageMediaId   String?
  image          Media?             @relation("PromoBannerImage", fields: [imageMediaId], references: [id])
  variant        PromoBannerVariant @default(DISCOUNT)
  sortOrder      Int                @default(0)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean            @default(true)
  clicks         Int                @default(0)
  deletedAt      DateTime?
  createdById    String?
  createdBy      User?              @relation("PromoBannerCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?              @relation("PromoBannerUpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("promo_banners")
}

model PromoPackage {
  id            String   @id @default(cuid())
  badge         String?
  title         String
  price         Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @db.Decimal(12, 2)
  features      Json
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id])
  isDark        Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdById   String?
  createdBy     User?    @relation("PromoPackageCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?    @relation("PromoPackageUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("promo_packages")
}

model Cta {
  id            String       @id @default(cuid())
  location      CtaLocation? @unique // null = CTA default, dipakai halaman tanpa varian sendiri
  title         String
  // *En/*Zh kosong = fallback ke versi Bahasa Indonesia di publik (lihat
  // getLocalizedCta() di src/lib/locale-field.ts).
  titleEn       String?
  titleZh       String?
  subtitle      String?
  subtitleEn    String?
  subtitleZh    String?
  buttonLabel   String
  buttonLabelEn String?
  buttonLabelZh String?
  whatsapp      String? // null -> fallback ke Settings.whatsapp
  createdById   String?
  createdBy     User?        @relation("CtaCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?        @relation("CtaUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("ctas")
}

// ====================================================
// Domain 5 — Interaksi Pengunjung
// ====================================================

enum InquiryStatus {
  BARU
  DIPROSES
  SELESAI
}

model Inquiry {
  id           String        @id @default(cuid())
  name         String
  email        String
  whatsapp     String
  serviceId    String? // null = kasus "Lainnya"
  service      Service?      @relation(fields: [serviceId], references: [id])
  message      String        @db.Text
  status       InquiryStatus @default(BARU)
  assignedToId String?
  assignedTo   User?         @relation("InquiryAssignee", fields: [assignedToId], references: [id])
  // Dibuat oleh pengunjung publik via form kontak, bukan admin -> gak ada createdBy.
  // updatedBy nyatet admin yg terakhir ubah status/detail inquiry ini.
  updatedById  String?
  updatedBy    User?         @relation("InquiryUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("inquiries")
}

// ====================================================
// Domain 5b — Service Transaction Management (/transaksi, /tracking)
//
// Menggantikan Order + mock /tracking lama TOTAL — Order gak pernah punya
// admin UI/pemakaian nyata (cuma 3 baris seed mock), jadi aman diganti
// tanpa migrasi data. Satu transaksi = SATU service + SATU paket (bukan
// keranjang multi-item) — workflow-nya disalin dari WorkflowTemplate milik
// service itu pas transaksi dibuat, supaya perubahan template belakangan
// gak mengubah histori transaksi yg udah jalan.
// ====================================================

enum WorkflowStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REVISION
  REJECTED
  SKIPPED
}

/**
 * Blueprint tahapan kerja per layanan (mis. "Pendirian PT" 9 langkah) —
 * dikelola admin di /transaksi/workflow, disalin (bukan direferensikan
 * langsung) ke tiap ServiceTransaction pas dibuat.
 */
model WorkflowTemplate {
  id          String    @id @default(cuid())
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  description String?   @db.Text
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("WorkflowTemplateCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("WorkflowTemplateUpdatedBy", fields: [updatedById], references: [id])
  deletedById String?
  deletedBy   User?     @relation("WorkflowTemplateDeletedBy", fields: [deletedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps        WorkflowTemplateStep[]
  transactions ServiceTransaction[]

  @@map("service_workflow_templates")
}

model WorkflowTemplateStep {
  id                       String                    @id @default(cuid())
  templateId               String
  template                 WorkflowTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name                     String
  description              String?                   @db.Text
  order                    Int
  estimatedDays            Int?
  requiredDocuments        Json? // string[]
  defaultStatus            WorkflowStepStatus        @default(PENDING)
  transactionWorkflowSteps TransactionWorkflowStep[]

  @@index([templateId])
  @@map("service_workflow_template_steps")
}

enum TransactionStatus {
  DRAFT
  WAITING_PAYMENT
  PAID
  PROCESSING
  ON_HOLD
  REVISION
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum TransactionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ServiceTransaction {
  id            String  @id @default(cuid())
  code          String  @unique // TRX-{YYYYMMDD}-{seq}, lihat lib/transaction-code.ts
  invoiceNumber String? @unique // INV-{YYYYMM}-{seq}

  customerName    String
  customerEmail   String
  customerPhone   String
  customerCompany String?

  serviceId          String
  service            Service           @relation(fields: [serviceId], references: [id])
  packageId          String?
  package            ServicePackage?   @relation(fields: [packageId], references: [id])
  workflowTemplateId String? // referensi template asal (buat jejak historis) — workflow instance-nya sendiri ada di TransactionWorkflowStep
  workflowTemplate   WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id])
  assignedStaffId    String?
  assignedStaff      User?             @relation("ServiceTransactionAssignedStaff", fields: [assignedStaffId], references: [id])

  priority                TransactionPriority @default(NORMAL)
  startDate               DateTime?
  estimatedCompletionDate DateTime?
  completionDate          DateTime?

  totalPrice Decimal @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @db.Decimal(12, 2)

  paymentStatus PaymentStatus     @default(UNPAID)
  status        TransactionStatus @default(DRAFT)

  internalNotes String? @db.Text
  customerNotes String? @db.Text

  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("ServiceTransactionCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("ServiceTransactionUpdatedBy", fields: [updatedById], references: [id])
  deletedById String?
  deletedBy   User?     @relation("ServiceTransactionDeletedBy", fields: [deletedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workflowSteps   TransactionWorkflowStep[]
  payments        Payment[]
  attachments     TransactionAttachment[]
  activityLogs    TransactionActivityLog[]
  trackingLookups TrackingLookupLog[]

  @@index([status])
  @@index([paymentStatus])
  @@map("service_transactions")
}

/**
 * Instance workflow MILIK SATU transaksi — disalin dari
 * WorkflowTemplateStep pas transaksi dibuat (name/description ikut
 * disalin, bukan direferensikan, biar histori transaksi yg udah jalan gak
 * berubah kalau template-nya diedit belakangan).
 */
model TransactionWorkflowStep {
  id              String                @id @default(cuid())
  transactionId   String
  transaction     ServiceTransaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  templateStepId  String?
  templateStep    WorkflowTemplateStep? @relation(fields: [templateStepId], references: [id], onDelete: SetNull)
  name            String
  description     String?               @db.Text
  order           Int
  status          WorkflowStepStatus    @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  updatedById     String?
  updatedBy       User?                 @relation("TransactionWorkflowStepUpdatedBy", fields: [updatedById], references: [id])
  notes           String?               @db.Text
  progressPercent Int                   @default(0)
  estimatedDays   Int?
  updatedAt       DateTime              @updatedAt

  attachments TransactionAttachment[]

  @@index([transactionId])
  @@map("service_transaction_workflows")
}

model Payment {
  id            String             @id @default(cuid())
  transactionId String
  transaction   ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Decimal            @db.Decimal(12, 2)
  method        String?
  paidAt        DateTime
  note          String?            @db.Text
  recordedById  String?
  recordedBy    User?              @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime           @default(now())

  @@index([transactionId])
  @@map("payments")
}

/**
 * Lampiran dokumen transaksi — file generik (PDF/DOC/XLS/gambar), TIDAK
 * lewat pipeline Media (yg cuma buat gambar & selalu di-reencode ke WebP).
 * visibleToCustomer nentuin apakah lampiran ini muncul di /tracking publik.
 */
model TransactionAttachment {
  id                String                   @id @default(cuid())
  transactionId     String
  transaction       ServiceTransaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  workflowStepId    String?
  workflowStep      TransactionWorkflowStep? @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  fileName          String
  url               String
  mimeType          String
  sizeBytes         Int
  visibleToCustomer Boolean                  @default(false)
  uploadedById      String?
  uploadedBy        User?                    @relation("TransactionAttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt         DateTime                 @default(now())

  @@index([transactionId])
  @@map("service_transaction_attachments")
}

/**
 * Activity + audit trail 1 transaksi — dipakai sekaligus utk section
 * "Activity Timeline", "Revision History" (filter action terkait revisi),
 * dan "Audit Log" (tampilkan kolom ipAddress/device tambahan) di halaman
 * detail transaksi admin.
 */
model TransactionActivityLog {
  id            String             @id @default(cuid())
  transactionId String
  transaction   ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String? // null = aksi sistem (mis. auto-complete)
  user          User?              @relation("TransactionActivityLogUser", fields: [userId], references: [id])
  action        String
  description   String?            @db.Text
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  device        String? // Desktop/Mobile/Tablet, lihat lib/article-stats.ts parseDeviceType
  userAgent     String?            @db.Text
  createdAt     DateTime           @default(now())

  @@index([transactionId])
  @@map("service_transaction_logs")
}

/**
 * Log tiap kali pengunjung publik berhasil lacak transaksi via kode — sama
 * pola dgn ArticleView (lib/article-stats.ts), dipakai laporan/analitik
 * modul Transaksi belakangan.
 */
model TrackingLookupLog {
  id            String             @id @default(cuid())
  transactionId String
  transaction   ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  device        String?
  country       String?
  city          String?
  createdAt     DateTime           @default(now())

  @@index([transactionId])
  @@map("service_tracking_histories")
}

// ====================================================
// Domain 6 — Navigasi & Konfigurasi
// ====================================================

model Menu {
  id          String     @id @default(cuid())
  key         String     @unique // "header" | "footer"
  name        String
  deletedAt   DateTime? // soft delete
  deletedById String?
  deletedBy   User?      @relation("MenuDeletedBy", fields: [deletedById], references: [id])
  items       MenuItem[]
  createdById String?
  createdBy   User?      @relation("MenuCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?      @relation("MenuUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("menus")
}

model MenuItem {
  id          String     @id @default(cuid())
  menuId      String
  menu        Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    MenuItem[] @relation("MenuItemChildren")
  label       String
  labelEn     String? // kosong = fallback ke `label` (Bahasa Indonesia) di publik
  labelZh     String? // kosong = fallback ke `label` (Bahasa Indonesia) di publik
  href        String
  sortOrder   Int        @default(0)
  deletedAt   DateTime? // soft delete
  deletedById String?
  deletedBy   User?      @relation("MenuItemDeletedBy", fields: [deletedById], references: [id])
  createdById String?
  createdBy   User?      @relation("MenuItemCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?      @relation("MenuItemUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("menu_items")
}

// Singleton (1 row, id selalu "1") — persis 4 tab /admin/settings (Umum, Kontak, Sosmed, SEO)
model Settings {
  id String @id @default("1")

  // Tab Umum — *En/*Zh kosong = fallback ke versi Bahasa Indonesia di publik
  // Bahasa yang dipakai pengunjung baru (belum pernah pilih bahasa lewat
  // LocaleSwitcher, ditandai cookie) saat buka URL tanpa prefix locale —
  // lihat getLocale() di src/i18n/get-dictionary.ts. Gak mengubah struktur
  // URL (id tetap satu-satunya locale tanpa prefix /en /zh), cuma nentuin
  // konten bahasa apa yang tampil duluan.
  defaultLocale    String  @default("id")
  companyName      String
  companyNameEn    String?
  companyNameZh    String?
  tagline          String
  taglineEn        String?
  taglineZh        String?
  description      String  @db.Text
  descriptionEn    String? @db.Text
  descriptionZh    String? @db.Text
  operatingHours   String
  operatingHoursEn String?
  operatingHoursZh String?

  // Tab Kontak
  whatsapp String // format internasional tanpa "+", mis. "6282280007821"
  email    String
  address  String  @db.Text
  mapsUrl  String
  // Src iframe "Sematkan peta" dari Google Maps (Bagikan → Sematkan peta →
  // salin src) buat peta di section Lokasi beranda. Kosong = fallback ke
  // embed otomatis dari `address` (lihat LocationSection.tsx).
  mapsEmbedUrl String? @db.Text

  // Tab Sosial Media (kosong = ikon disembunyikan di footer/navbar)
  socialLinkedin  String?
  socialFacebook  String?
  socialInstagram String?
  socialX         String?
  socialYoutube   String?

  // Tab SEO (default global — dioverride per Page/BlogPost via metaTitle/metaDescription sendiri)
  seoTitle       String
  seoDescription String @db.Text
  seoKeywords    String

  // Branding / identitas visual
  appLogoUrl String?
  faviconUrl String?

  // Tab Font — gaya font teks website publik per bahasa (nilai = slug di
  // FONT_OPTIONS, lihat src/lib/fonts.ts). Selalu terisi (gak nullable,
  // beda dari *En/*Zh field lain) karena font wajib resolve ke sesuatu.
  // Panel admin/CMS TIDAK terpengaruh — tetap pakai Plus Jakarta Sans.
  fontFamilyId String @default("plus-jakarta-sans")
  fontFamilyEn String @default("inter")
  fontFamilyZh String @default("noto-sans-sc")

  // Tab Maintenance — nyala = pengunjung publik cuma liat halaman
  // "Under Maintenance", ADMIN/SUPER_ADMIN tetap bisa browsing situs asli
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String? @db.Text // kosong = pakai pesan default di halaman maintenance

  // Tab Integrasi — device_id akun WhaCenter (gateway WhatsApp pihak
  // ketiga, order.whacenter.com) dipakai modul Transaksi buat kirim
  // invoice + link tracking + QR code ke customer (lib/whacenter.ts).
  // Kosong = fitur "Kirim WhatsApp" di detail transaksi dinonaktifkan.
  whacenterDeviceId String?

  // Singleton, gak pernah "dibuat" lewat admin (selalu ada dari seed) -> gak ada createdBy
  updatedById String?
  updatedBy   User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

// Singleton teks Hero (bagian paling atas beranda) — gambar & kartu statistik
// masih hardcode di komponen (HeroSection.tsx), belum di scope ini.
model HeroContent {
  id String @id @default("1")

  // *En/*Zh kosong = fallback ke versi Bahasa Indonesia di publik (lihat
  // getLocalizedHeroContent() di src/app/(public)/page.tsx)
  titleLine1       String
  titleLine1En     String?
  titleLine1Zh     String?
  titleHighlight   String // baris tengah judul, dirender warna primary
  titleHighlightEn String?
  titleHighlightZh String?
  titleLine3       String
  titleLine3En     String?
  titleLine3Zh     String?
  subtitle         String  @db.Text
  subtitleEn       String? @db.Text
  subtitleZh       String? @db.Text

  // 3 badge highlight di bawah subtitle — [{ title, subtitle }, ...] x3.
  // Ikon tiap badge tetap hardcode di komponen sesuai urutan index. EN/ZH
  // fallback per-badge (bukan per-array) — lihat pickHighlights().
  highlights   Json
  highlightsEn Json?
  highlightsZh Json?

  ctaPrimaryLabel     String // href tombol ini tetap ikut WHATSAPP_URL, cuma labelnya yg bisa diubah
  ctaPrimaryLabelEn   String?
  ctaPrimaryLabelZh   String?
  ctaSecondaryLabel   String
  ctaSecondaryLabelEn String?
  ctaSecondaryLabelZh String?
  ctaSecondaryHref    String // path internal — sama di semua bahasa, gak perlu varian

  // Gambar kolom kanan Hero — null = pakai kartu gradient placeholder bawaan
  // (lihat DEFAULT_HERO_CONTENT / fallback di HeroSection.tsx)
  heroImageUrl String?

  // Singleton, gak pernah "dibuat" lewat admin (selalu ada dari seed) -> gak ada createdBy
  updatedById String?
  updatedBy   User?    @relation("HeroContentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("hero_content")
}

enum AboutVideoSource {
  YOUTUBE
  UPLOAD
}

// Singleton konten section "Tentang IzinPro" di BERANDA (bukan halaman
// /tentang-kami — itu di AboutPageContent di bawah). Sama pola dgn
// HeroContent: single row id="1", *En/*Zh kosong = fallback ke Bahasa
// Indonesia di publik. Video kolom kanan bisa YouTube (link ditempel admin
// apa adanya, dikonversi ke embed URL saat render — lihat
// extractYoutubeEmbedUrl() di lib/youtube.ts) atau file upload (disimpan
// apa adanya di public/uploads/about-home, TIDAK lewat pipeline Media/Sharp
// krn itu khusus gambar — sama alasan dgn TransactionAttachment).
