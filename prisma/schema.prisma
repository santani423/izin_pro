  // array (aboutParagraphs/stats/values/mission) fallback per-index, bukan
  // per-array — sama pola dgn HeroContent.highlightsEn/Zh.
  heroKicker           String?
  heroKickerEn         String?
  heroKickerZh         String?
  heroTitle            String
  heroTitleEn          String?
  heroTitleZh          String?
  heroTitleHighlight   String
  heroTitleHighlightEn String?
  heroTitleHighlightZh String?
  heroSubtitleBold     String
  heroSubtitleBoldEn   String?
  heroSubtitleBoldZh   String?
  heroSubtitleBody     String  @db.Text
  heroSubtitleBodyEn   String? @db.Text
  heroSubtitleBodyZh   String? @db.Text
  heroImageUrl         String?

  aboutKicker           String
  aboutKickerEn         String?
  aboutKickerZh         String?
  aboutTitle            String
  aboutTitleEn          String?
  aboutTitleZh          String?
  aboutTitleHighlight   String
  aboutTitleHighlightEn String?
  aboutTitleHighlightZh String?
  aboutParagraphs       Json // string[]
  aboutParagraphsEn     Json?
  aboutParagraphsZh     Json?
  aboutImageUrl         String?
  stats                 Json // { icon: string; value: string; label: string }[] — stats[0] jadi sumber badge foto mengambang juga
  statsEn               Json? // { value: string; label: string }[] — icon tetap ikut `stats` (gak per-bahasa)
  statsZh               Json?

  valuesEnabled          Boolean @default(true)
  valuesTitle            String
  valuesTitleEn          String?
  valuesTitleZh          String?
  valuesTitleHighlight   String
  valuesTitleHighlightEn String?
  valuesTitleHighlightZh String?
  valuesSubtitle         String
  valuesSubtitleEn       String?
  valuesSubtitleZh       String?
  values                 Json // { icon: string; title: string; description: string }[]
  valuesEn               Json? // { title: string; description: string }[] — icon tetap ikut `values`
  valuesZh               Json?

  visiMisiEnabled Boolean @default(true)
  vision          String  @db.Text
  visionEn        String? @db.Text
  visionZh        String? @db.Text
  visionImageUrl  String? // null -> pakai ilustrasi skyline bawaan /images/tentang-skyline-v3.png (bukan gradient)
  mission         Json // string[]
  missionEn       Json?
  missionZh       Json?
  missionImageUrl String? // null -> kartu gradient placeholder bawaan (beda dari Visi, blm ada ilustrasi desain asli utk Misi)

  teamEnabled          Boolean @default(true)
  teamTitle            String // prefix, mis. "Tim" — lihat TentangTeamSection: "{teamTitle} {teamTitleHighlight} Kami"
