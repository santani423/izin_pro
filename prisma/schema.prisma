  id String @id @default("1")

  heading       String
  headingEn     String?
  headingZh     String?
  description   String  @db.Text
  descriptionEn String? @db.Text
  descriptionZh String? @db.Text
  points        Json // string[] — daftar checklist ("Legal & Resmi", dst)
  pointsEn      Json?
  pointsZh      Json?

  buttonLabel   String
  buttonLabelEn String?
  buttonLabelZh String?
  buttonHref    String  @default("/tentang-kami") // internal — sama di semua bahasa, gak perlu diterjemahkan

  videoTitle   String // judul aksesibilitas pop-up video (aria-label & <title> iframe/video)
  videoTitleEn String?
  videoTitleZh String?

  videoSource     AboutVideoSource @default(YOUTUBE)
  videoYoutubeUrl String? // URL asli yg ditempel admin (watch/youtu.be/shorts/embed), dikonversi saat render
  videoUploadUrl  String? // path /uploads/about-home/xxx.mp4 kalau videoSource=UPLOAD

  // Singleton, gak pernah "dibuat" lewat admin (selalu ada dari seed) -> gak ada createdBy
  updatedById String?
  updatedBy   User?    @relation("AboutHomeContentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("about_home_content")
}

// Singleton konten halaman /tentang-kami — sama pola dgn HeroContent
// (single row id="1", JSON utk array item berulang, gambar nullable dgn
// fallback placeholder/gradient bawaan kalau kosong). Anggota tim ASLI-nya
// ada di TeamMember (dikelola /admin/tim), bukan di sini.
