// Singleton konten seluruh halaman /kontak (banner + tiap section body) —
// sama pola dgn PromoPageContent. Pesan yang dikirim dari form-nya TETAP di
// tabel relasional Inquiry (sudah ada di schema), bukan di sini. FAQ section
// juga TETAP baca dari model Faq (scope=KONTAK, sudah ada admin-nya di
// /admin/faq) — di sini cuma judul section & kartu bantuan di sampingnya.
model KontakPageContent {
  id String @id @default("1")

  // Banner
  heroKicker         String?
  heroTitle          String
  heroTitleHighlight String
  heroDescription    String  @db.Text
  heroImageUrl       String? // null -> kartu gradient placeholder bawaan (lihat PageHero.tsx)

  // Bar info kontak di bawah banner — { icon: string; title: string; value: string; note: string }[]
  infoCards Json

  // Section form + sidebar kanal kontak
  formTitle       String
  formSubtitle    String @db.Text
  sidebarTitle    String
  sidebarSubtitle String @db.Text
  // { icon: string; title: string; value?: string; note?: string; href: string }[]
  channels        Json

  // Section lokasi kantor — alamat & tombol maps tetap dari Settings (COMPANY_INFO),
  // cuma judul & embed peta yang disimpan di sini (spesifik halaman ini).
  locationTitle String
  mapsEmbedUrl  String @db.Text

  // Section FAQ — judul + kartu bantuan (daftar FAQ-nya sendiri di model Faq scope=KONTAK)
  faqTitlePrefix      String // "Pertanyaan yang"
  faqTitleHighlight   String // "Sering Diajukan"
  helpCardTitle       String
  helpCardDescription String  @db.Text
  helpCardButtonLabel String
  helpCardImageUrl    String? // null -> pakai foto bawaan /images/promo-konsultasi.png

  // Singleton, gak pernah "dibuat" lewat admin (selalu ada dari seed) -> gak ada createdBy
  updatedById String?
  updatedBy   User?    @relation("KontakPageContentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("kontak_page_content")
}

// Singleton konten Hero/banner /blog — sama pola dgn KontakPageContent/
// TestimoniPageContent (single row id="1", gambar nullable dgn fallback
// gradient placeholder bawaan). Daftar artikelnya sendiri TETAP di model
// BlogPost (sudah ada), ini cuma teks & gambar banner di atas katalog.
model BlogPageContent {
  id String @id @default("1")

  heroKicker         String?
  heroTitle          String
  heroTitleHighlight String
  heroDescription    String  @db.Text
  heroImageUrl       String? // null -> kartu gradient placeholder bawaan (lihat PageHero.tsx)

  // Singleton, gak pernah "dibuat" lewat admin (selalu ada dari seed) -> gak ada createdBy
  updatedById String?
  updatedBy   User?    @relation("BlogPageContentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("blog_page_content")
}

// ====================================================
// Domain 7 & 8 — Sistem & Analytics
// ====================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String
  referrer  String?
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}

enum CommentStatus {
  PENDING
  APPROVED
}

// Komentar pengunjung di halaman detail artikel blog — pengunjung anonim
// (tanpa akun), sama pola dgn Inquiry (gak ada createdBy). Wajib disetujui
// admin (status PENDING) sebelum tampil publik, biar gak langsung ke-spam.
model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  name      String
  email     String
  content   String        @db.Text
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([postId])
  @@map("comments")
}

// Log tiap kunjungan halaman detail artikel — dipakai buat breakdown
// device & lokasi di panel Statistik /admin/blog (beda dari PageView di
// atas yg generic & belum kepakai; ArticleView spesifik ke BlogPost lewat
// FK spy gampang di-groupBy per artikel).
model ArticleView {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  device    String // "Desktop" | "Mobile" | "Tablet"
  country   String? // dari header geolocation Vercel — null kalau gak terdeteksi (mis. dev lokal)
  city      String?
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("article_views")
}

model DailyStat {
  id             String   @id @default(cuid())
  date           DateTime @unique
  totalViews     Int      @default(0)
  uniqueVisitors Int      @default(0)
  bounceRate     Float?
  avgDuration    Float?
  createdAt      DateTime @default(now())

  @@map("daily_stats")
}
